<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LearnQuickTyping.App.ViewModels"
             x:Class="LearnQuickTyping.App.Views.LyricsResult"
             x:DataType="vm:LyricsExerciseViewModel"
             Title="Results">

    <VerticalStackLayout 
        Padding="40" 
        Spacing="30" 
        VerticalOptions="Center" 
        HorizontalOptions="Center">

        <Label 
            Text="🎉 Results 🎉" 
            FontSize="32" 
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

        <BoxView 
            HeightRequest="2" 
            Color="Gray" 
            WidthRequest="300"/>

        <VerticalStackLayout Spacing="15">

            <Label 
                Text="{Binding TimeDisplay}" 
                FontSize="18"
                HorizontalOptions="Center"/>

            <Label 
                Text="{Binding WpmDisplay}" 
                FontSize="18"
                HorizontalOptions="Center"/>

            <Label 
                Text="{Binding ResultMessage}" 
                TextColor="{Binding ResultColor}" 
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Margin="0,20,0,0"/>
        </VerticalStackLayout>

        <BoxView 
            HeightRequest="2" 
            Color="Gray" 
            WidthRequest="300"/>

        <Button 
            Text="Choose Next Lyric"
            Command="{Binding ContinueToNextTextCommand}"
            WidthRequest="250"
            HeightRequest="50"
            FontSize="16"
            BackgroundColor="#4CAF50"
            TextColor="White"
            HorizontalOptions="Center"
            Margin="0,20,0,0"/>

    </VerticalStackLayout>

</ContentPage>
