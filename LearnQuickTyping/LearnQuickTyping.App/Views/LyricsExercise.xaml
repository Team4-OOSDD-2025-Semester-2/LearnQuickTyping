<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LearnQuickTyping.App.ViewModels"
             x:Class="LearnQuickTyping.App.Views.LyricsExercise"
             x:DataType="vm:LyricsExerciseViewModel">

    <VerticalStackLayout 
        Padding="30,0"
        Spacing="25" 
        VerticalOptions="Center"
        HorizontalOptions="Center">

        <Picker
            x:Name="TextPicker"
            Title="Kies een tekst"
            ItemsSource="{Binding LyricsTitles}"
            SelectedItem="{Binding SelectedLyricsTitle}"
            WidthRequest="300"
            HorizontalOptions="Center" />

        <Button
            Text="Start"
            Command="{Binding StartExerciseCommand}"
            IsVisible="{Binding IsStartButtonVisible}"
            WidthRequest="200"
            HorizontalOptions="Center" />

        <VerticalStackLayout
            IsVisible="{Binding IsExerciseVisible}"
            Spacing="15">

            <Label
                x:Name="PracticeTextLabel"
                HorizontalOptions="Center"/>

            <Entry 
                Text="{Binding InputText}"
                Placeholder="Copy text above and press enter when finished"
                ReturnCommand="{Binding CompleteTypingCommand}"
                MinimumWidthRequest="350"/>

            <Label
                Text="{Binding TimeDisplay}"
                HorizontalOptions="Center"/>

            <Label
                Text="{Binding WpmDisplay}"
                HorizontalOptions="Center"/>

            <Label
                Text="{Binding ResultMessage}"
                TextColor="{Binding ResultColor}"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>