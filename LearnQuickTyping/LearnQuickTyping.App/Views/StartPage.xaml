<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LearnQuickTyping.App.Views.StartPage"
             Title="Startpage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="20"
            VerticalOptions="Center">

            <Label
                Text="LearnQuickTyping"
                Style="{StaticResource Headline}" />

            <Label 
                Text="Choose an exercise to get started"
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center" />

            <Button
                Text="Word Exercise"
                Clicked="OnWordPracticeClicked" />

            <Button
                Text="Text Exercise"
                Clicked="OnTextPracticeClicked" />

            <Button
                Text="Versus Mode"
                Clicked="OnVersusModeClicked" />

            <Button
                Text="Karaoke Mode"
                Clicked="OnKaraokeModeClicked" />

            <Button
                Text="Create Profile"
                Clicked="OnCreateProfileClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>